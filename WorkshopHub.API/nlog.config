<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Off">

  <!-- הקוד כותב לוגים דרך ILogger הרגיל של .NET. NLog מחובר מתחת (builder.Host.UseNLog),
       וכל ההחלטות – לאן כותבים, באיזה פורמט ומאיזו רמה – יושבות בקובץ הזה ולא בקוד. -->

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- הרמה המינימלית ללוגים של האפליקציה. Program.cs דורס את הערך לפי AppLogging:MinLevel:
       Debug בסביבת פיתוח (appsettings.Development.json), Info בכל סביבה אחרת (appsettings.json). -->
  <variable name="appMinLevel" value="Info" />

  <variable name="logDirectory" value="${currentdir}/logs" />

  <!-- ה-CorrelationId נכנס ל-scope של הלוג ב-CorrelationIdMiddleware, ולכן הוא מופיע בכל שורה של אותה בקשה -->
  <variable name="lineLayout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets async="true">
    <!-- כל הלוגים, קובץ ליום -->
    <target xsi:type="File" name="allFile"
            fileName="${var:logDirectory}/workshophub-${shortdate}.log"
            layout="${var:lineLayout}"
            encoding="utf-8" />

    <!-- רק Warning ומעלה: התנגשויות על מקומות (Warning) וכשלים (Error) – מה שרוצים למצוא מהר אחר כך -->
    <target xsi:type="File" name="warningsFile"
            fileName="${var:logDirectory}/warnings-${shortdate}.log"
            layout="${var:lineLayout}"
            encoding="utf-8" />

    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Warning ומעלה מכל מקור – גם לקובץ הנפרד -->
    <logger name="*" minlevel="Warn" writeTo="warningsFile" />

    <!-- הודעות עליית השרת -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,allFile" final="true" />

    <!-- משתיקים את הרעש של התשתית (ASP.NET Core, EF Core, HttpClient) מתחת ל-Warning -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- הלוגים של האפליקציה: מ-Debug בפיתוח, מ-Info בסביבות אחרות -->
    <logger name="WorkshopHub.*" minlevel="${var:appMinLevel}" writeTo="console,allFile" final="true" />

    <!-- כל השאר (כולל Warning ומעלה של התשתית) -->
    <logger name="*" minlevel="Info" writeTo="console,allFile" />
  </rules>
</nlog>
