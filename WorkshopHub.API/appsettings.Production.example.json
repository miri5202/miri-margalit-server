{
  "ConnectionStrings": {
    "Default": "Host=<db host>;Port=5432;Database=<db name>;Username=<db user>;Password=<db password>"
  },

  "Jwt": {
    "Key": "<random string of at least 32 characters>"
  },

  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": false
  },

  "AdminAccount": {
    "Email": "<admin email>",
    "Password": "<admin password, at least 12 characters>"
  },

  "Swagger": {
    "Enabled": true
  },

  "Https": {
    "Redirect": false
  }
}
